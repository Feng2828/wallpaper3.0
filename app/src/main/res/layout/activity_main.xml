<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="相册随机壁纸"
            android:textColor="#1F2733"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="HyperOS 适配 · 悬浮球替代桌面双击"
            android:textColor="#8A94A3"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvWallpaperState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/card_bg"
            android:elevation="2dp"
            android:padding="12dp"
            android:text="壁纸状态：检测中…"
            android:textColor="#2F6FEB"
            android:textSize="13sp" />

        <!-- ===== 1. 相册文件夹 ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_bg"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="① 相册文件夹"
                android:textColor="#1F2733"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAlbum"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="尚未选择"
                android:textColor="#6B7684"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnPickAlbum"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#2F6FEB"
                android:text="选择相册文件夹（一次性导入全部图片）"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnPickTree"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="2dp"
                android:text="找不到相册？改用「目录方式」选择"
                android:textColor="#2F6FEB"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- ===== 2. 手动同步 ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_bg"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="② 手动同步"
                android:textColor="#1F2733"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPool"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="壁纸池：0 张"
                android:textColor="#6B7684"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnSync"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#2F6FEB"
                android:text="手动同步"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvSyncInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="只有点击本按钮才会扫描相册；不点击时不会后台扫描。"
                android:textColor="#8A94A3"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- ===== 3. 切换间隔 ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_bg"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="③ 切换间隔"
                android:textColor="#1F2733"
                android:textSize="15sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgInterval"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rb30"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="30 秒"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/rb60"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="60 秒"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/rb120"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="120 秒"
                    android:textSize="13sp" />
            </RadioGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="按真实时间计时：停在桌面、使用其它 App、息屏期间都照常切换；随机抽取，切换时旧图打底、新图 600ms 渐显。"
                android:textColor="#8A94A3"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- ===== 4. 悬浮球 ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_bg"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="④ 悬浮球（替代桌面双击）"
                android:textColor="#1F2733"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Switch
                android:id="@+id/swBall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="启用悬浮球（仅桌面显示，点一下换一张）"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvBallState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="权限状态：检测中…"
                android:textColor="#8A94A3"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnPermissions"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="2dp"
                android:text="开启权限 / 后台保活设置"
                android:textColor="#2F6FEB"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvKeepAlive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="提示：HyperOS 需手动开启自启动、省电策略「无限制」，详见避坑指南。"
                android:textColor="#8A94A3"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnSetWallpaper"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="18dp"
            android:backgroundTint="#1F2733"
            android:text="设为动态壁纸"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            android:text="后续更新：下载新 APK 直接点开覆盖安装即可，无需卸载"
            android:textColor="#A0A9B6"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
